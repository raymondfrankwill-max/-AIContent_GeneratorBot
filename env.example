# Get this from @BotFather on Telegram after running /newbot
TELEGRAM_BOT_TOKEN=

# Get this from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Model to use for generation. Defaults to claude-sonnet-5 if unset.
CLAUDE_MODEL=claude-sonnet-5

# Optional: used only in the /start welcome message
BOT_USERNAME=AIContent_GeneratorBot
